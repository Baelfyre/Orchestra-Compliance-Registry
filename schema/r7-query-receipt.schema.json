{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestra.compliance-registry.r7-query-receipt.v1",
  "title": "R7 Registry Query Receipt",
  "type": "object",
  "required": ["schema_version","authority","canonical_repository","registry_authority_realm","publication_trust","registry_version","release_sequence","release_tag","release_manifest_sha256","registry_manifest_sha256","registry_semantic_sha256","relationship_semantic_sha256","backend","projection","representation","query_semantic_sha256","result_semantic_sha256","exact_source_ids","exact_obligation_ids","freshness_evidence","capability_negotiation_evidence","domain_routing_evidence","next_cursor","integrity_disposition","authority_expansion","model_authored_integrity_repair","external_reverification_required_before_trust_or_mutation","promotion_from_receipt_forbidden"],
  "properties": {
    "schema_version": {"const": "orchestra.compliance-registry.r7-query-receipt.v1"},
    "authority": {"const": "NONE_EVIDENCE_ONLY"},
    "canonical_repository": {"const": "Baelfyre/Orchestra-Compliance-Registry"},
    "registry_authority_realm": {"enum": ["EDITABLE_REGISTRY_STATE","TRUSTED_RELEASE_READ_MODEL"]},
    "publication_trust": {"enum": ["NOT_ESTABLISHED_BY_LOCAL_QUERY","TRUSTED_RELEASE_IDENTITY_VERIFIED"]},
    "registry_version": {"type": "string", "minLength": 1},
    "release_sequence": {"type": "integer", "minimum": 0},
    "release_tag": {"type": ["string","null"]},
    "release_manifest_sha256": {"type": ["string","null"], "pattern": "^[0-9a-f]{64}$"},
    "registry_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relationship_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backend": {"enum": ["DIRECT_LOCAL_INDEXED_GATEWAY","DIRECT_LOCAL_JSON_QUERY"]},
    "projection": {"enum": ["MINIMAL","SUMMARY","EVIDENCE","FULL"]},
    "representation": {"enum": ["JSON","TOON"]},
    "query_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exact_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "exact_obligation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "freshness_evidence": {"type": "array", "items": {"type": "object"}},
    "capability_negotiation_evidence": {"type": "array", "items": {"type": "object", "required": ["capability_id","contract_version","status"], "properties": {"capability_id": {"type": "string", "minLength": 1}, "contract_version": {"type": "string", "minLength": 1}, "status": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "domain_routing_evidence": {"type": "object", "required": ["requested_domain","returned_domains"], "properties": {"requested_domain": {"type": ["string","null"]}, "returned_domains": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false},
    "next_cursor": {"type": ["string","null"]},
    "integrity_disposition": {"enum": ["VERIFIED_INDEX","DIRECT_CANONICAL_JSON"]},
    "authority_expansion": {"const": false},
    "model_authored_integrity_repair": {"const": false},
    "external_reverification_required_before_trust_or_mutation": {"const": true},
    "promotion_from_receipt_forbidden": {"const": true}
  },
  "additionalProperties": false
}
