{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestra.compliance-registry.source.v1",
  "title": "Compliance Source Record",
  "type": "object",
  "required": [
    "source_id",
    "title",
    "source_type",
    "authority",
    "canonical_url",
    "jurisdiction_ids",
    "domains",
    "verification",
    "interpretation_boundary"
  ],
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "source_type": {
      "enum": ["STATUTE", "REGULATION", "IMPLEMENTING_RULES", "REGULATORY_CIRCULAR", "REGULATORY_ADVISORY"]
    },
    "authority": {"type": "string", "minLength": 1},
    "canonical_url": {"type": "string", "pattern": "^https://[^\\s]+$"},
    "jurisdiction_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "issued_date": {"type": "string", "format": "date"},
    "effective_date": {"type": "string", "format": "date"},
    "supersession_note": {"type": "string", "minLength": 1},
    "verification": {
      "type": "object",
      "required": ["status", "verified_at", "method", "authority_domain"],
      "properties": {
        "status": {
          "enum": [
            "VERIFIED_CURRENT",
            "CURRENT_WITH_PENDING_CHANGE",
            "NOT_EFFECTIVE_YET",
            "SUPERSEDED",
            "REPEALED",
            "SOURCE_UNAVAILABLE",
            "SOURCE_MOVED",
            "APPLICABILITY_UNRESOLVED",
            "HUMAN_INTERPRETATION_REQUIRED",
            "REVIEW_OVERDUE"
          ]
        },
        "verified_at": {"type": "string", "format": "date"},
        "method": {"type": "string", "minLength": 1},
        "authority_domain": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "interpretation_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
